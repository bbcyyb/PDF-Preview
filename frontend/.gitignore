# Frontend: Node.js + Vite + TypeScript

# 依赖目录
node_modules/
jspm_packages/
web_modules/

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node.js 诊断报告
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# TypeScript 与构建缓存
*.tsbuildinfo
.eslintcache
.stylelintcache
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
node_modules/.tmp/
node_modules/.vite/

# 构建产物
dist/
build/
out/

# npm 打包输出
*.tgz

# 包管理器缓存和状态
.npm/
.pnpm-store/
.yarn-integrity
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# 前端工具缓存
.cache/
.parcel-cache/
.next/
.nuxt/
.output/
.svelte-kit/
**/.vitepress/dist/
**/.vitepress/cache/
.docusaurus/
.firebase/
.vscode-test/
