# 仓库级通用忽略规则。

# 日志
logs
*.log

# 运行时数据
pids
*.pid
*.seed
*.pid.lock

# 覆盖率输出
coverage/
*.lcov

# 环境变量文件
.env
.env.*
!.env.example

# 本地编辑器和系统文件
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# 构建产物由各应用目录的 .gitignore 管理。

# 本项目保留 frontend/public/fixtures、frontend/docs、frontend/fixtures 和 openspec 文档，不在此忽略。
