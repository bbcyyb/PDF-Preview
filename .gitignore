# 基于 GitHub 官方 Node.gitignore，并按本项目的 Vite + React + TypeScript 结构调整。

# 日志
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Node.js 诊断报告
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# 运行时数据
pids
*.pid
*.seed
*.pid.lock

# 覆盖率输出
coverage/
*.lcov
.nyc_output/

# 依赖目录
node_modules/
jspm_packages/
web_modules/

# TypeScript 与构建缓存
*.tsbuildinfo
.eslintcache
.stylelintcache
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
node_modules/.tmp/
node_modules/.vite/

# 构建产物
dist/
build/
out/

# npm 打包输出
*.tgz

# 环境变量文件
.env
.env.*
!.env.example

# 包管理器缓存和状态
.npm/
.pnpm-store/
.yarn-integrity
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# 框架和工具缓存
.cache/
.parcel-cache/
.next/
.nuxt/
.output/
.svelte-kit/
**/.vitepress/dist/
**/.vitepress/cache/
.docusaurus/
.serverless/
.firebase/
.fusebox/
.dynamodb/
.tern-port
.vscode-test/

# 本地编辑器和系统文件
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# 本项目保留 public/fixtures、fixtures/source、docs 和 openspec 文档，不在此忽略。
