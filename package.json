{
  "name": "pdf-preview-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "mvn -f backend/pom.xml package",
    "preview:frontend": "npm --prefix frontend run preview",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "npm --prefix frontend run test",
    "test:backend": "mvn -f backend/pom.xml test",
    "fixtures:generate": "npm --prefix frontend run fixtures:generate",
    "fixtures:check": "npm --prefix frontend run fixtures:check"
  }
}
